# 서비스 Docker에 전달하는 SSH_PASSWORD와 같은 값을 입력하세요.
SSH_PASSWORD=

# 서비스 도메인의 DNS는 이 VPS를 가리켜야 합니다.
SISH_DOMAIN=ourmemories.kr

# 기존 Caddy와 동시에 실행하려면 테스트용 포트로 변경하세요.
SISH_BIND_ADDRESS=0.0.0.0
SISH_HTTP_PORT=80
SISH_HTTPS_PORT=443
SISH_SSH_PORT=2222

# 선택 사항: Let's Encrypt 알림용 이메일
SISH_CERTIFICATE_EMAIL=

