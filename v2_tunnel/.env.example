# 서비스 Docker에 전달하는 SSH_PASSWORD와 같은 값을 입력하세요.
SSH_PASSWORD=

# 서비스 도메인의 DNS는 이 VPS를 가리켜야 합니다.
SISH_DOMAIN=ourmemories.kr

# 기존 Caddy와 동시에 실행하려면 테스트용 포트로 변경하세요.
SISH_BIND_ADDRESS=0.0.0.0
SISH_HTTP_PORT=80
SISH_HTTPS_PORT=443
SISH_SSH_PORT=2222

# 선택 사항: Let's Encrypt 알림용 이메일
SISH_CERTIFICATE_EMAIL=

# 기본적으로 첫 HTTPS 요청에서 인증서를 발급합니다.
# 직접 준비한 .crt/.key만 사용할 때는 false로 설정하세요.
SISH_HTTPS_ONDEMAND=true

# 프로세스 종료 및 응답 정지 감지
SISH_START_TIMEOUT=30
SISH_HEALTH_INTERVAL=5
SISH_HEALTH_FAILURES=3
